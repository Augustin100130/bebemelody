<html>
<head>
    <title>1012-css漸層與動畫</title>
    <style>
        div{
            width: 200px;
            height: 100px;
            margin-bottom: 10px;
        }
        #d1{
            background-image: linear-gradient(90deg,red,yellow);/*線性漸層*/
        }
        #d2{/* 方向0~360deg, 多個顏色用逗點分開*/
            background-image: linear-gradient(90deg,red,orange,yellow,green,blue,indigo,violet);/*線性漸層*/
            width: 400px;
            height: 50px;
        }
        #d3{/*輻射漸層*/
            background-image: radial-gradient(yellow,white,black);
            height: 200px;

        }
        #d4{/*預設會隨容器改變，第一參數設定circle可強制為圓形*/
            background-image: radial-gradient(circle,yellow,white,black);
            

        }
        #d5{/*圓錐漸層*/
            background-image: conic-gradient(red,green,blue,red);
        }
        #d6{/*第一參數可調整起始位置*/
            background-image: conic-gradient(from 90deg,red,green,blue,red);
        }
        /*以上是基本語法，以下是小小進階:
        顏色的後面加上百分比代表位置，起點是0%，終點是100%
        */
        #d7{
            background-image: linear-gradient(90deg,red 33%,white 33%,white 66%,blue 66%);

        }
        #d8{
            background-image: radial-gradient(circle,red 33%,white 33%,white 66%,blue 66%);

        }
        #d9{
            background-image: repeating-linear-gradient(125deg,red 30%,white 35%,red 40%);
        }
        
        #d10{
            background-image: repeating-linear-gradient(circle,red 30%,white 35%,red 40%);
            
        }
        #d11{
            background-image: conic-gradient(red 33%,white 33%,white 66%,blue 66%);
            
        }
        #d12{
            background-image: repeating-conic-gradient(red 30%,white 35%,red 40%);
        }
        /*動畫*/
        @keyframes k1{
            0%{background-image: linear-gradient(90deg,red,white 50%,blue);}
            8%{background-image: linear-gradient(90deg,red,white 40%,blue);}
            16%{background-image: linear-gradient(90deg,red,white 30%,blue);}
            24%{background-image: linear-gradient(90deg,red,white 20%,blue);}
            32%{background-image: linear-gradient(90deg,red,white 30%,blue);}
            40%{background-image: linear-gradient(90deg,red,white 40%,blue);}
            50%{background-image: linear-gradient(90deg,red,white 50%,blue);}
            58%{background-image: linear-gradient(90deg,red,white 60%,blue);}
            66%{background-image: linear-gradient(90deg,red,white 70%,blue);}
            74%{background-image: linear-gradient(90deg,red,white 80%,blue);}
            82%{background-image: linear-gradient(90deg,red,white 70%,blue);}
            90%{background-image: linear-gradient(90deg,red,white 60%,blue);}
            100%{background-image: linear-gradient(90deg,red,white 50%,blue);}
        }
        #a1 {
            animation: k1 1s infinite linear;
        }
        @keyframes k2 {
            0%{ background-image: linear-gradient(0deg,red,blue);}
            10%{ background-image: linear-gradient(30deg,red,blue);}
            20%{ background-image: linear-gradient(60deg,red,blue);}
            30%{ background-image: linear-gradient(90deg,red,blue);}
            40%{ background-image: linear-gradient(120deg,red,blue);}
            50%{ background-image: linear-gradient(150deg,red,blue);}
            60%{ background-image: linear-gradient(180deg,red,blue);}
            70%{ background-image: linear-gradient(210deg,red,blue);}
            80%{ background-image: linear-gradient(240deg,red,blue);}
            90%{ background-image: linear-gradient(270deg,red,blue);}
            100%{ background-image: linear-gradient(300deg,red,blue);}
        }
        #a2{
            animation: k2 1s infinite linear;
        }
        @keyframes k3 {
            0% { background: radial-gradient(circle,yellow,white,black);}
        }
        #a3 {
            animation: k3 0.5s infinite linear;
        }
        @keyframes k4{
            0%{background: repeating-linear-gradient(125deg,red 30%,white 35%,red 40%);}
        }
        #a4 {
            animation: k4 0.5s infinite linear;
        }
        @keyframes k5{
            0%

        }
        #a5 {
            animation: k5 0.5s infinite linear;
        }
        @keyframes k6{

        }
        #a6{
            animation: k6 0.3s infinite linear;
        }




    </style>
</head>
<body>
    <div id="d1"></div>
    <div id="d2"></div>
    <div id="d3"></div>
    <div id="d4"></div>
    <div id="d5"></div>
    <div id="d6"></div>
    <hr>
    <div id="d7"></div>
    <div id="d8"></div>
    <div id="d9"></div>
    <div id="d10"></div>
    <div id="d11"></div>
    <div id="d12"></div>
    <hr>
    <div id="a1"></div>
    <div id="a2"></div>
    <div id="a3"></div>
    <div id="a4"></div>

</body>
</html>